{
  "name": "tuesday-recorder",
  "version": "1.1.0",
  "description": "A simple Windows audio recorder with per-source mixing and MP3 output.",
  "main": "src/main.js",
  "author": "Tuesday Works",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "ffmpeg-static": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.journeytohealing.tuesdayrecorder",
    "productName": "Tuesday Recorder 1.1",
    "artifactName": "Tuesday Recorder 1.1.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "win": {
      "icon": "src/assets/tuesday.ico",
      "target": [
        "portable"
      ]
    }
  }
}
